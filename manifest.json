{
  "manifest_version": 3,
  "name": "Figma CSS Compare",
  "description": "Compare Figma CSS with webpage elements.",
  "version": "1.0",
  "permissions": [
    "scripting",
    "activeTab",
    "storage"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "128": "icon.png"
    }
  }
}